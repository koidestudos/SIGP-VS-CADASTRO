rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdminEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'sandgyferreira@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdminEmail()
        || (
          hasUserDoc()
          && (
            userData().get('role', '') == 'admin'
            || userData().get('perfil', '') == 'admin'
          )
        )
      );
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isDiretoria() {
      return isAdmin() || (hasUserDoc() && (
        userData().get('role', '') == 'diretoria'
        || userData().get('perfil', '') == 'diretoria'
      ));
    }

    function isGerenciaRole() {
      return hasUserDoc() && (
        userData().get('role', '') == 'gerencia'
        || userData().get('perfil', '') == 'gerencia'
      );
    }

    function userGerencia() {
      return hasUserDoc()
        ? userData().get('gerenciaId', userData().get('gerencia', ''))
        : '';
    }

    function catalogGerencia(coordId) {
      return exists(/databases/$(database)/documents/coordenacoes/$(coordId))
        ? get(/databases/$(database)/documents/coordenacoes/$(coordId)).data.gerencia
        : '';
    }

    function resourceGerencia() {
      return ('gerencia' in resource.data && resource.data.gerencia in ['GAS', 'GVS', 'GAP'])
        ? resource.data.gerencia
        : catalogGerencia(resource.data.coordenacaoId);
    }

    function gerenciaMatchesCoordenacao(data) {
      let gerOk = !('gerencia' in data)
        || data.gerencia == ''
        || data.gerencia == catalogGerencia(data.coordenacaoId);
      let idOk = !('gerenciaId' in data)
        || data.gerenciaId == ''
        || data.gerenciaId == catalogGerencia(data.coordenacaoId);
      return gerOk && idOk;
    }

    function validStatus(status) {
      return status in [
        'Rascunho', 'Enviado para Diretoria', 'Programada', 'Priorizada', 'Autorizada',
        'Em execução', 'Realizada', 'Cancelada', 'Reprovada',
        'Em análise', 'Pendente', 'Autorizado', 'Aprovado',
        'Enviada para Gerência',
        'Aguardando aprovação da Gerência',
        'Devolvida para correção',
        'Reenviada para análise',
        'Aprovada pela Gerência'
      ];
    }

    function validProgramacaoFields(data) {
      return data.keys().hasAll(['titulo', 'coordenacaoId', 'dataInicial', 'dataFinal', 'status', 'criadoPor'])
        && data.titulo is string
        && data.titulo.size() > 0
        && data.titulo.size() <= 500
        && data.coordenacaoId is string
        && data.coordenacaoId.size() <= 80
        && data.dataInicial is string
        && data.dataFinal is string
        && data.status is string
        && validStatus(data.status)
        && data.criadoPor is string
        && data.criadoPor.size() <= 128
        && (!('criadoPorUid' in data) || (data.criadoPorUid is string && data.criadoPorUid.size() <= 128))
        && (!('criadoPorNome' in data) || (data.criadoPorNome is string && data.criadoPorNome.size() <= 200))
        && (!('criadoPorEmail' in data) || (data.criadoPorEmail is string && data.criadoPorEmail.size() <= 320))
        && (!('responsavel' in data) || (data.responsavel is string && data.responsavel.size() <= 200))
        && (!('objetivo' in data) || (data.objetivo is string && data.objetivo.size() <= 5000))
        && (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 5000))
        && (!('equipe' in data) || data.equipe is list)
        && (!('equipe' in data) || data.equipe.size() <= 50)
        && (
          data.status in ['Rascunho', 'Realizada', 'Cancelada', 'Reprovada']
          || (('equipe' in data) && data.equipe is list && data.equipe.size() >= 1)
        )
        && (!('municipioIds' in data) || data.municipioIds is list)
        && (!('municipioIds' in data) || data.municipioIds.size() <= 20)
        && (!('regionalIds' in data) || data.regionalIds is list)
        && (!('regionalIds' in data) || data.regionalIds.size() <= 20)
        && (!('transporteTipo' in data) || data.transporteTipo in ['sim', 'nao', 'microonibus'])
        && (!('gerencia' in data) || data.gerencia in ['GAS', 'GVS', 'GAP', ''])
        && (!('gerenciaId' in data) || data.gerenciaId in ['GAS', 'GVS', 'GAP', ''])
        && (!('historico' in data) || (data.historico is list && data.historico.size() <= 50))
        && (!('justificativaDevolucao' in data) || (data.justificativaDevolucao is string && data.justificativaDevolucao.size() <= 2000))
        && (!('enviadoPorNome' in data) || (data.enviadoPorNome is string && data.enviadoPorNome.size() <= 200))
        && (!('aprovadoPorNome' in data) || (data.aprovadoPorNome is string && data.aprovadoPorNome.size() <= 200))
        && (!('statusAlteradoPorUid' in data) || (data.statusAlteradoPorUid is string && data.statusAlteradoPorUid.size() <= 128))
        && (!('statusAlteradoPorNome' in data) || (data.statusAlteradoPorNome is string && data.statusAlteradoPorNome.size() <= 200))
        && (!('statusAlteradoEm' in data) || (data.statusAlteradoEm is string));
    }

    function validUserProfile(data) {
      return data.nome is string
        && data.nome.size() <= 200
        && data.email is string
        && data.email.size() <= 320
        && (!('role' in data) || data.role in ['admin', 'usuario', 'diretoria', 'gerencia'])
        && (!('perfil' in data) || data.perfil in ['admin', 'usuario', 'diretoria', 'gerencia'])
        && (!('perfil' in data) || !('role' in data) || data.perfil == data.role)
        && (!('ativo' in data) || data.ativo is bool)
        && (!('gerencia' in data) || data.gerencia in ['GAS', 'GVS', 'GAP', ''])
        && (!('gerenciaId' in data) || data.gerenciaId in ['GAS', 'GVS', 'GAP', ''])
        && (!('coordenacaoId' in data) || (data.coordenacaoId is string && data.coordenacaoId.size() <= 80));
    }

    function isDiretoriaOnly() {
      return hasUserDoc() && (
        userData().get('role', '') == 'diretoria'
        || userData().get('perfil', '') == 'diretoria'
      ) && !isAdmin();
    }

    function isMembroRole() {
      return hasUserDoc() && userData().get('role', 'usuario') == 'usuario';
    }

    function canCreateProgramacaoRole() {
      return isAdmin() || isGerenciaRole() || (isSignedIn() && !isDiretoriaOnly());
    }

    function authorUnchanged() {
      return request.resource.data.get('criadoPor', '') == resource.data.get('criadoPor', '')
        && request.resource.data.get('criadoPorUid', '') == resource.data.get('criadoPorUid', '');
    }

    function isProgramacaoAuthor() {
      return isSignedIn()
        && resource.data.criadoPor is string
        && resource.data.criadoPor.size() > 0
        && resource.data.criadoPor == request.auth.uid;
    }

    function ownerAllowedStatusTransition() {
      return request.resource.data.status == resource.data.status
        || (
          resource.data.status in [
            'Rascunho',
            'Devolvida para correção',
            'Aguardando aprovação da Gerência',
            'Reenviada para análise'
          ]
          && request.resource.data.status in [
            'Rascunho',
            'Aguardando aprovação da Gerência',
            'Reenviada para análise'
          ]
        );
    }

    function isOwnerContentUpdate() {
      return isProgramacaoAuthor()
        && authorUnchanged()
        && validProgramacaoFields(request.resource.data)
        && gerenciaMatchesCoordenacao(request.resource.data)
        && ownerAllowedStatusTransition();
    }

    function statusOnlyAffectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'atualizadoEm', 'historico',
        'statusAlteradoPorUid', 'statusAlteradoPorNome', 'statusAlteradoEm',
        'aprovadoPor', 'aprovadoPorNome', 'aprovadoEm',
        'devolvidoPor', 'devolvidoPorNome', 'devolvidoEm', 'justificativaDevolucao',
        'enviadoEm', 'enviadoPor', 'enviadoPorNome', 'autorizadoEm',
        'gerencia', 'gerenciaId'
      ]);
    }

    function gerenciaFieldsUnchanged() {
      return request.resource.data.get('gerencia', resource.data.get('gerencia', ''))
          == resource.data.get('gerencia', '')
        && request.resource.data.get('gerenciaId', resource.data.get('gerenciaId', ''))
          == resource.data.get('gerenciaId', '');
    }

    function canManageGerenciaStatus() {
      return isAdmin() || (isGerenciaRole() && resourceGerencia() == userGerencia());
    }

    function canSetAdminRole(data) {
      return isBootstrapAdminEmail() && data.role == 'admin';
    }

    function isGerenciaDecisionUpdate() {
      return canManageGerenciaStatus()
        && authorUnchanged()
        && validProgramacaoFields(request.resource.data)
        && resource.data.status in [
          'Aguardando aprovação da Gerência', 'Reenviada para análise', 'Enviado para Diretoria', 'Enviada para Gerência'
        ]
        && request.resource.data.status in ['Aprovada pela Gerência', 'Devolvida para correção']
        && (
          request.resource.data.status != 'Devolvida para correção'
          || (
            'justificativaDevolucao' in request.resource.data
            && request.resource.data.justificativaDevolucao is string
            && request.resource.data.justificativaDevolucao.size() > 0
          )
        );
    }

    // Status-only: não exige validProgramacaoFields (equipe etc.) — só status válido
    function isGerenciaStatusOnlyUpdate() {
      return canManageGerenciaStatus()
        && authorUnchanged()
        && request.resource.data.status is string
        && validStatus(request.resource.data.status)
        && statusOnlyAffectedKeys()
        && gerenciaFieldsUnchanged();
    }

    function isRealizadaPorAnexoUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'atualizadoEm', 'historico', 'statusAlteradoPorUid', 'statusAlteradoPorNome', 'statusAlteradoEm'])
        && request.resource.data.status == 'Realizada'
        && resource.data.status != 'Reprovada'
        && resource.data.status != 'Cancelada';
    }

    match /programacoes/{programacaoId} {
      allow read: if isSignedIn();

      allow create: if canCreateProgramacaoRole()
        && validProgramacaoFields(request.resource.data)
        && gerenciaMatchesCoordenacao(request.resource.data)
        && request.resource.data.criadoPor == request.auth.uid
        && (
          !('criadoPorUid' in request.resource.data)
          || request.resource.data.criadoPorUid == request.auth.uid
        )
        && request.resource.data.status in [
          'Rascunho',
          'Aguardando aprovação da Gerência',
          'Reenviada para análise'
        ];

      allow update: if canManageGerenciaStatus() && isRealizadaPorAnexoUpdate();

      allow update: if isGerenciaDecisionUpdate();

      allow update: if isGerenciaStatusOnlyUpdate();

      allow update: if isOwnerContentUpdate();

      // Administrador: permissão total (editar, status, qualquer campo)
      allow update: if isAdmin();

      allow delete: if isAdmin()
        || (isMembroRole() && isProgramacaoAuthor());
    }

    match /logistica/{logisticaId} {
      allow read: if isSignedIn();

      allow create: if canCreateProgramacaoRole()
        && request.resource.data.keys().hasAll(['programacaoId', 'municipioId', 'situacao'])
        && request.resource.data.programacaoId is string
        && request.resource.data.municipioId is string
        && request.resource.data.situacao in ['Solicitado', 'Confirmado']
        && request.resource.data.transporte is bool
        && request.resource.data.alimentacao is bool;

      allow update: if (isAdmin() || isGerenciaRole())
        && request.resource.data.keys().hasAll(['programacaoId', 'municipioId', 'situacao'])
        && request.resource.data.programacaoId is string
        && request.resource.data.municipioId is string
        && request.resource.data.situacao in ['Solicitado', 'Confirmado']
        && request.resource.data.transporte is bool
        && request.resource.data.alimentacao is bool;

      allow delete: if isAdmin()
        || (
          isMembroRole()
          && resource.data.programacaoId is string
          && exists(/databases/$(database)/documents/programacoes/$(resource.data.programacaoId))
          && get(/databases/$(database)/documents/programacoes/$(resource.data.programacaoId)).data.criadoPor == request.auth.uid
          && get(/databases/$(database)/documents/programacoes/$(resource.data.programacaoId)).data.criadoPor is string
          && get(/databases/$(database)/documents/programacoes/$(resource.data.programacaoId)).data.criadoPor.size() > 0
        );
    }

    match /users/{userId} {
      // get: a própria conta ou Diretoria/Admin. list separado para a consulta da aba Contas
      // não falhar (regra com isOwner no list bloqueia a coleção inteira).
      allow get: if isOwner(userId) || isDiretoria();
      allow list: if isDiretoria();

      allow create: if isOwner(userId)
        && validUserProfile(request.resource.data)
        && (!('role' in request.resource.data) || canSetAdminRole(request.resource.data))
        && (!('ativo' in request.resource.data) || request.resource.data.ativo == true);

      allow update: if isOwner(userId)
        && validUserProfile(request.resource.data)
        && (
          !('role' in request.resource.data)
          || request.resource.data.role == resource.data.get('role', 'usuario')
          || canSetAdminRole(request.resource.data)
        )
        && (
          !('ativo' in request.resource.data)
          || request.resource.data.ativo == resource.data.get('ativo', true)
        );

      allow update: if isAdmin()
        && validUserProfile(request.resource.data)
        && request.resource.data.role in ['admin', 'usuario', 'diretoria', 'gerencia'];
    }

    match /acessos/{acessoId} {
      allow read: if isDiretoria();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 200
        && request.resource.data.criadoEm is string;
      allow delete: if isAdmin();
    }

    match /notificacoes/{notifId} {
      allow read: if isDiretoria() || isGerenciaRole()
        || (isSignedIn() && resource.data.criadoPor == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['tipo', 'titulo', 'lido', 'criadoEm'])
        && request.resource.data.tipo is string
        && request.resource.data.tipo in [
          'programacao_enviada', 'programacao_anexo', 'programacao_devolvida', 'programacao_aprovada'
        ]
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 500
        && request.resource.data.lido is bool;
      allow update: if isDiretoria() || isGerenciaRole()
        || (isSignedIn() && resource.data.criadoPor == request.auth.uid);
      allow delete: if isDiretoria();
    }

    function canWriteProgramacaoAnexo() {
      return isAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/programacoes/$(request.resource.data.programacaoId))
          && get(/databases/$(database)/documents/programacoes/$(request.resource.data.programacaoId)).data.criadoPor == request.auth.uid
        );
    }

    match /programacao_anexos/{anexoId} {
      allow read: if isSignedIn();

      allow create: if canWriteProgramacaoAnexo()
        && request.resource.data.keys().hasAll([
          'programacaoId', 'programacaoTitulo', 'nomeArquivo', 'storagePath',
          'downloadUrl', 'enviadoPor', 'enviadoPorNome', 'enviadoEm'
        ])
        && request.resource.data.programacaoId is string
        && request.resource.data.programacaoId.size() > 0
        && request.resource.data.programacaoTitulo is string
        && request.resource.data.programacaoTitulo.size() <= 500
        && request.resource.data.nomeArquivo is string
        && request.resource.data.nomeArquivo.size() > 0
        && request.resource.data.nomeArquivo.size() <= 300
        && request.resource.data.storagePath is string
        && request.resource.data.downloadUrl is string
        && request.resource.data.enviadoPor == request.auth.uid
        && request.resource.data.enviadoPorNome is string
        && request.resource.data.enviadoEm is string
        && (!('tamanho' in request.resource.data) || request.resource.data.tamanho is number)
        && (!('mimeType' in request.resource.data) || request.resource.data.mimeType is string)
        && (!('coordenacaoId' in request.resource.data) || request.resource.data.coordenacaoId is string)
        && (!('enviadoPorEmail' in request.resource.data) || request.resource.data.enviadoPorEmail is string)
        && (!('chunkCount' in request.resource.data) || request.resource.data.chunkCount is number)
        && (!('conteudo' in request.resource.data) || (
          request.resource.data.conteudo is string
          && request.resource.data.conteudo.size() <= 900000
        ))
        && (!('conteudoBytes' in request.resource.data) || (
          request.resource.data.conteudoBytes is bytes
          && request.resource.data.conteudoBytes.size() <= 700000
        ))
        && (!('storedIn' in request.resource.data) || request.resource.data.storedIn in [
          'storage', 'firestore', 'firestore-chunks'
        ]);

      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if isSignedIn();
        allow create: if (
            isAdmin()
            || (
              isSignedIn()
              && get(/databases/$(database)/documents/programacao_anexos/$(anexoId)).data.enviadoPor == request.auth.uid
            )
          )
          && request.resource.data.keys().hasAll(['index', 'data'])
          && request.resource.data.index is number
          && (
            (request.resource.data.data is bytes && request.resource.data.data.size() <= 700000)
            || (request.resource.data.data is string && request.resource.data.data.size() <= 450000)
          );
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /coordenacoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /municipios/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /regionais/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /suporte_admins/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(docId);
    }

    match /suporte_chats/{chatId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      match /mensagens/{msgId} {
        allow read: if isSignedIn() && (
          isAdmin() || get(/databases/$(database)/documents/suporte_chats/$(chatId)).data.userId == request.auth.uid
        );
        allow create: if isSignedIn() && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000;
        allow delete: if isAdmin() || (
          isSignedIn()
          && get(/databases/$(database)/documents/suporte_chats/$(chatId)).data.userId == request.auth.uid
        );
      }
    }
  }
}
